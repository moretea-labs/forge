{
  "manifest_version": 3,
  "name": "Forge Workflow Supervisor",
  "version": "0.1.0",
  "description": "Executes daemon-authorized Forge Workflow Supervisor turns in exact ChatGPT conversations.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "https://chatgpt.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "core.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}

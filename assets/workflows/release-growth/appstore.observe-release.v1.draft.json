{
  "schemaVersion": 1,
  "workflowId": "appstore.observe-release",
  "version": "2",
  "title": "App Store version and mainland territory availability observation",
  "description": "Read-only Apple version state plus typed appAvailabilityV2 territory data. No Browser UI fallback and no release claim from version state alone.",
  "inputContract": {
    "app_id": {
      "type": "string",
      "required": true
    },
    "version_string": {
      "type": "string",
      "required": true
    }
  },
  "steps": [
    {
      "stepId": "validate-app-version",
      "kind": "script",
      "scriptRef": "validateAppVersion",
      "input": {
        "app_id": "{{input.app_id}}",
        "version_string": "{{input.version_string}}"
      },
      "outputContract": {
        "app_id": {
          "type": "string",
          "required": true
        },
        "version_string": {
          "type": "string",
          "required": true
        }
      }
    },
    {
      "stepId": "read-version",
      "capabilityId": "asc.list_app_store_versions",
      "input": {
        "app_id": "{{output.validate-app-version.app_id}}",
        "limit": 20
      },
      "outputContract": {
        "data": {
          "type": "json",
          "required": true
        },
        "links": {
          "type": "json",
          "required": true
        }
      }
    },
    {
      "stepId": "classify-version",
      "kind": "script",
      "scriptRef": "classifyVersion",
      "input": {
        "version_string": "{{output.validate-app-version.version_string}}",
        "versions": "{{output.read-version.data}}",
        "links": "{{output.read-version.links}}"
      },
      "outputContract": {
        "version": {
          "type": "string",
          "required": true
        },
        "app_store_state": {
          "type": "string",
          "required": true
        },
        "app_version_state": {
          "type": "string",
          "required": true
        },
        "release_type": {
          "type": "string",
          "required": true
        },
        "downloadable": {
          "type": "json",
          "required": true
        },
        "next_action": {
          "type": "string",
          "required": true
        }
      }
    },
    {
      "stepId": "read-territory-availability",
      "capabilityId": "asc.list_app_territory_availabilities",
      "input": {
        "app_id": "{{output.validate-app-version.app_id}}",
        "territory_id": "CHN",
        "limit": 200
      },
      "outputContract": {
        "data": {
          "type": "json",
          "required": true
        },
        "links": {
          "type": "json",
          "required": true
        }
      }
    },
    {
      "stepId": "classify-cn",
      "kind": "script",
      "scriptRef": "classifyCn",
      "input": {
        "data": "{{output.read-territory-availability.data}}",
        "links": "{{output.read-territory-availability.links}}"
      },
      "outputContract": {
        "territory": {
          "type": "string",
          "required": true
        },
        "status": {
          "type": "string",
          "required": true
        },
        "available": {
          "type": "json",
          "required": true
        },
        "content_statuses": {
          "type": "json",
          "required": true
        },
        "release_date": {
          "type": "json",
          "required": true
        }
      }
    },
    {
      "stepId": "decide-verified-next-action",
      "kind": "script",
      "scriptRef": "decideNextAction",
      "input": {
        "version_action": "{{output.classify-version.next_action}}",
        "cn_status": "{{output.classify-cn.status}}"
      },
      "outputContract": {
        "next_action": {
          "type": "string",
          "required": true
        },
        "public_storefront_and_download_proof_required": {
          "type": "json",
          "required": true
        }
      }
    }
  ],
  "scripts": {
    "validateAppVersion": {
      "runtime": "node",
      "deterministic": true,
      "outputFormat": "json",
      "body": "const a=JSON.parse(process.argv[1]||'{}');const id=String(a.app_id||'').trim();const version=String(a.version_string||'').trim();if(!/^[0-9]{7,15}$/.test(id)){process.stderr.write('INVALID_APP_ID');process.exit(2)}if(!/^[0-9]+(?:\\.[0-9]+){1,2}$/.test(version)){process.stderr.write('INVALID_VERSION_STRING');process.exit(3)}process.stdout.write(JSON.stringify({app_id:id,version_string:version}));"
    },
    "classifyVersion": {
      "runtime": "node",
      "deterministic": true,
      "outputFormat": "json",
      "body": "const x=JSON.parse(process.argv[1]||'{}');const v=x.versions;const target=String(x.version_string||'');if(!Array.isArray(v)||!target||!x.links||typeof x.links!=='object'){process.stderr.write('VERSION_RECORDS_MISSING');process.exit(2)}if(x.links.next){process.stderr.write('VERSION_PAGINATION_INCOMPLETE');process.exit(3)}const matches=v.filter(r=>String(r?.attributes?.versionString||'')===target);if(matches.length!==1){process.stderr.write('VERSION_TARGET_NOT_UNIQUE');process.exit(4)}const a=matches[0]?.attributes||{};const appStoreState=String(a.appStoreState||'unknown');const appVersionState=String(a.appVersionState||'unknown');const releaseType=String(a.releaseType||'unknown');let next_action='inspect_release_state';if(['REJECTED','METADATA_REJECTED'].includes(appVersionState))next_action='prepare_correction';else if(['WAITING_FOR_REVIEW','IN_REVIEW','WAITING_FOR_EXPORT_COMPLIANCE'].includes(appVersionState))next_action='await_or_inspect_review';else if(appStoreState==='READY_FOR_SALE')next_action='verify_territories';else if(appStoreState==='PENDING_DEVELOPER_RELEASE'&&releaseType==='MANUAL')next_action='manual_release_required';else if(appStoreState==='PENDING_DEVELOPER_RELEASE'&&releaseType==='AFTER_APPROVAL')next_action='await_apple_release';else if(appVersionState==='READY_FOR_DISTRIBUTION')next_action='inspect_release_state';process.stdout.write(JSON.stringify({version:target,app_store_state:appStoreState,app_version_state:appVersionState,release_type:releaseType,downloadable:typeof a.downloadable==='boolean'?a.downloadable:null,next_action}));"
    },
    "decideNextAction": {
      "runtime": "node",
      "deterministic": true,
      "outputFormat": "json",
      "body": "const x=JSON.parse(process.argv[1]||'{}');const v=x.version_action;const c=x.cn_status;const versionActions=new Set(['prepare_correction','await_or_inspect_review','await_apple_release','verify_territories','manual_release_required','inspect_release_state']);const cnStatuses=new Set(['icp_missing','not_available','available','unknown']);if(!versionActions.has(v)||!cnStatuses.has(c)){process.stderr.write('RELEASE_DECISION_INPUT_UNVERIFIED');process.exit(2)}let next_action='reconcile_asc_release_state';if(v==='prepare_correction')next_action='prepare_correction';else if(v==='await_or_inspect_review')next_action='await_or_inspect_review';else if(v==='await_apple_release')next_action='await_apple_release';else if(c==='icp_missing')next_action='resolve_cn_icp';else if(c==='not_available')next_action='reconcile_cn_distribution';else if(c==='unknown')next_action='reconcile_cn_territory';else if(v==='manual_release_required')next_action='manual_release_after_authorization';else if(v==='verify_territories')next_action='verify_cn_storefront_download';process.stdout.write(JSON.stringify({next_action,public_storefront_and_download_proof_required:next_action==='verify_cn_storefront_download'}));"
    },
    "classifyCn": {
      "runtime": "node",
      "deterministic": true,
      "outputFormat": "json",
      "body": "const a=JSON.parse(process.argv[1]||'{}');const rows=a.data;if(!Array.isArray(rows)||!a.links||typeof a.links!=='object'){process.stderr.write('CN_TERRITORY_DATA_MISSING');process.exit(2)}if(a.links.next){process.stderr.write('CN_TERRITORY_PAGINATION_INCOMPLETE');process.exit(3)}const matches=rows.filter(r=>r?.relationships?.territory?.data?.id==='CHN');if(matches.length!==1){process.stderr.write('CN_TERRITORY_ROW_NOT_UNIQUE');process.exit(4)}const attrs=matches[0]?.attributes||{};const ava...
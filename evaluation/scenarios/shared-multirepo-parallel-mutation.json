{
  "schemaVersion": "forge-evaluation-scenario/v1",
  "id": "shared-multirepo-parallel-mutation",
  "title": "Apply independent mutations to two repositories concurrently",
  "userIntent": "Resolve primary and secondary repositories, then issue two explicitly scoped safe-patch creates concurrently, one per repository.",
  "snapshot": { "source": ".", "commit": "c873cfeb11a223ced342e7101c016261b4a93b38" },
  "fixtures": { "repositories": [{ "id": "secondary" }] },
  "groundTruth": {
    "intendedBehavior": ["Independent repository mutation lanes do not corrupt each other and each change lands only in its target repository."],
    "affectedDomains": ["multi-repository", "concurrency", "bounded mutation"],
    "behavioralInvariants": ["Primary and secondary changes are separately attributable by evaluator-owned changed-path evidence."],
    "regressionRisks": ["A global mutation lane incorrectly serializes or rejects independent repositories, or mutations cross repository boundaries."]
  },
  "execution": { "interface": "forge_mcp", "profile": "controller", "toolset": "advanced", "calls": [
    { "id": "primary", "tool": "repository_list", "arguments": {}, "capture": { "primaryRepo": "repositories.0.repoId" } },
    { "id": "secondary", "tool": "repository_register", "arguments": { "path": "{{fixture.secondary.repository}}" }, "capture": { "secondaryRepo": "repository.repoId" } },
    { "id": "write-primary", "tool": "repository_safe_patch_apply", "parallelGroup": "writes", "arguments": { "repo_id": "{{primaryRepo}}", "purpose": "Primary concurrent evaluation mutation", "allowed_paths": ["evaluation-primary-concurrent.txt"], "operations": [{ "type": "create", "path": "evaluation-primary-concurrent.txt", "content": "primary\n" }] } },
    { "id": "write-secondary", "tool": "repository_safe_patch_apply", "parallelGroup": "writes", "arguments": { "repo_id": "{{secondaryRepo}}", "purpose": "Secondary concurrent evaluation mutation", "allowed_paths": ["evaluation-secondary-concurrent.txt"], "operations": [{ "type": "create", "path": "evaluation-secondary-concurrent.txt", "content": "secondary\n" }] } }
  ] },
  "validators": [
    { "id": "primary-write-succeeds", "kind": "behavior", "type": "execution_output", "stepId": "write-primary", "expectedExitCode": 0 },
    { "id": "secondary-write-succeeds", "kind": "behavior", "type": "execution_output", "stepId": "write-secondary", "expectedExitCode": 0 },
    { "id": "writes-stay-separated", "kind": "change_precision", "type": "changed_paths", "requiredGlobs": ["evaluation-primary-concurrent.txt", "fixtures/secondary/evaluation-secondary-concurrent.txt"] }
  ],
  "corpus": { "class": "shared", "behaviorClass": "multi_repo_concurrency" },
  "provenance": { "kind": "historical_behavior", "sourceCommit": "c873cfeb11a223ced342e7101c016261b4a93b38", "note": "Shared concurrent mutation behavior anchored to the exact v1.7.2 release." }
}

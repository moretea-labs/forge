{
  "name": "@moretea-labs/forge",
  "version": "1.5.0-rc.1",
  "description": "Local-first action assistant for software work with resumable execution, bounded tools, and reviewable evidence",
  "license": "MIT",
  "author": "Moretea Labs contributors",
  "keywords": [
    "chatgpt",
    "ai-assistant",
    "mcp",
    "repository",
    "developer-tools",
    "automation",
    "agentic-workflow",
    "code-review",
    "local-first"
  ],
  "homepage": "https://github.com/moretea-labs/forge#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moretea-labs/forge.git"
  },
  "bugs": {
    "url": "https://github.com/moretea-labs/forge/issues"
  },
  "type": "module",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "LICENSE",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "SUPPORT.md",
    "CODE_OF_CONDUCT.md",
    "NOTICE",
    "THIRD_PARTY_NOTICES.md",
    "scripts/verify-forge-runtime.sh",
    "agents/",
    "assets/",
    "docs/README.md",
    "docs/tutorials/",
    "docs/images/",
    "docs/architecture/",
    "docs/operations/",
    "docs/wiki/",
    "docs/public-usage-guide.md",
    "docs/public-usage-guide.zh-CN.md",
    "docs/forge-chatgpt-browser-engine.md",
    "docs/forge-chatgpt-supervised-automation.md",
    "docs/forge-chatgpt-mcp-setup.md",
    "docs/forge-github-issue-launcher.md",
    "docs/forge-runtime-self-healing-loop.md",
    "docs/forge-autonomous-goal-loop.md",
    "docs/forge-provider-configuration.md",
    "docs/forge-plugin-management.md",
    "README.en.md",
    "README.zh-CN.md",
    "install.sh",
    "install.ps1",
    "bin/",
    "scripts/",
    "src/",
    "AGENTS.md",
    "CLAUDE.md",
    "SKILL.md",
    "README.md"
  ],
  "bin": {
    "forge": "bin/forge.mjs",
    "forge-hook": "bin/forge-hook.mjs",
    "forge-runtime": "bin/forge-runtime.mjs"
  },
  "engines": {
    "node": ">=20.10.0",
    "bun": ">=1.0.0"
  },
  "scripts": {
    "benchmark:skills": "bun scripts/run-skill-evals.ts",
    "benchmark:route-session-concurrency": "bun scripts/benchmark-route-session-concurrency.ts",
    "test": "bun scripts/test-governance.ts affected",
    "test:browser-live": "bun tests/live/browser-native-silent.e2e.ts",
    "test:core": "bun scripts/test-governance.ts core",
    "test:integration": "bun scripts/test-governance.ts integration",
    "test:infrastructure": "bun scripts/test-governance.ts infrastructure",
    "test:fault": "bun scripts/test-governance.ts fault",
    "test:full": "bun scripts/test-governance.ts full",
    "test:coverage": "bun test --coverage",
    "check:type": "bun x tsc --noEmit",
    "check:runtime-architecture": "node scripts/check-runtime-architecture.mjs",
    "check:executable-modes": "bun scripts/repair-executable-modes.ts --check",
    "repair:executable-modes": "bun scripts/repair-executable-modes.ts",
    "check:test-governance": "bun scripts/test-governance.ts validate",
    "check:mcp-compatibility": "node --loader ./src/runtime/shared/node-ts-loader.mjs scripts/check-mcp-compatibility.ts",
    "smoke:runtime-recovery": "node --loader ./src/runtime/shared/node-ts-loader.mjs scripts/smoke-runtime-recovery.ts",
    "smoke:mcp-http-runtime": "node --loader ./src/runtime/shared/node-ts-loader.mjs scripts/smoke-mcp-http-runtime.ts",
    "smoke:tool-surface": "bun scripts/smoke-mcp-tool-surface.ts",
    "check:smoke": "bun run smoke:mcp-http-runtime && bun run smoke:runtime-recovery && bun run smoke:schedule-engine && bun run smoke:tool-surface",
    "check:task": "bun scripts/run-governed-gate.ts task",
    "check:main": "bun scripts/run-governed-gate.ts main",
    "check:ci": "bun run check:main",
    "check:release": "bun scripts/run-governed-gate.ts release",
    "check:release-surface": "bash scripts/check-public-release-surface.sh",
    "check:release-readiness": "bash scripts/check-release-readiness.sh",
    "check:open-source-surface": "bash scripts/check-open-source-tracked-surface.sh",
    "check:public-docs": "bash scripts/check-public-docs.sh",
    "check:package-identity": "node scripts/check-package-identity.mjs",
    "check:third-party-notices": "node scripts/check-third-party-notices.mjs",
    "check:platform-support": "node scripts/check-platform-support.mjs",
    "check:public-export": "bun scripts/public-release.ts",
    "package:source-zip": "bash scripts/package-source-archive.sh",
    "check:release-published": "bash scripts/check-release-published.sh",
    "smoke:tarball-install": "bash scripts/check-tarball-install-smoke.sh",
    "check:release-version": "node scripts/check-release-version.mjs",
    "release:dry-run": "node scripts/check-release-version.mjs && bun run check:release",
    "release:rc": "bash scripts/publish-release-tarball.sh next",
    "release:stable": "bash scripts/publish-release-tarball.sh latest",
    "check:brain-manifest": "forge run check-brain-manifest",
    "check:context-files": "forge run check-context-files",
    "check:deploy-sql": "forge run check-deploy-sql-order",
    "check:architecture-sync": "forge run check-architecture-sync",
    "check:task-sync": "node bin/forge.mjs run check-task-sync",
    "check:task-workflow": "bash scripts/check-task-workflow.sh --strict",
    "runtime:activate-source-baseline": "bun scripts/activate-source-baseline.ts request",
    "plugin:install-desktop-operator": "bun scripts/install-desktop-operator-registration.ts",
    "sync:brain-docs": "forge run sync-brain-docs --all",
    "sync:codex-installed": "bash scripts/sync-codex-installed-copies.sh",
    "check:forge-runtime": "bash scripts/verify-forge-runtime.sh",
    "repo:registry": "bun src/cli/v81-entry.ts repo",
    "smoke:schedule-engine": "node --loader ./src/runtime/shared/node-ts-loader.mjs scripts/smoke-schedule-engine.ts",
    "smoke:supervised-automation": "node --loader ./src/runtime/shared/node-ts-loader.mjs scripts/smoke-chatgpt-supervised-automation.ts",
    "check:env": "node scripts/check-runtime-env.mjs",
    "test:bun": "bun -e 'console.error(\"[tests] test:bun is deprecated; running explicit test:full\")' && bun run test:full",
    "test:node-smoke": "node --test tests/node/*.test.mjs",
    "check:ci:portable": "FORGE_ALLOW_NODE_ONLY=1 bash scripts/check-ci.sh"
  },
  "devDependencies": {
    "@colbymchenry/codegraph": "1.0.1",
    "@types/bun": "latest",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.28.0",
    "commander": "^14.0.3",
    "express": "^5.2.1",
    "playwright": "^1.54.1"
  },
  "packageManager": "npm@10.0.0",
  "optionalDependencies": {
    "agent-device": "0.20.2"
  }
}

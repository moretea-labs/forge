{
  "schemaVersion": 1,
  "id": "runtime-recovery",
  "name": "运行时与恢复",
  "goal": "运行时健康或宕机时都能打开客户端，并通过独立恢复能力启动、重启、诊断和修复；关闭客户端不停止运行时。",
  "primaryAction": "repair-runtime",
  "constraints": [
    "运行时健康状态是全局事实",
    "运行时不可用时界面仍可使用",
    "所有修复动作都经恢复权威执行",
    "连接页面显示状态、权限与最近验证时间"
  ],
  "nodes": [
    {
      "id": "titlebar",
      "component": "NativeTitlebar",
      "props": {
        "title": "运行时",
        "subtitle": "系统",
        "runtimeState": "运行时不可用",
        "mode": "恢复",
        "searchPlaceholder": "搜索设置…",
        "showTrafficLights": true
      }
    },
    {
      "id": "sidebar",
      "component": "PrimarySidebar",
      "props": {
        "active": "运行时",
        "assistantLabel": "助手",
        "projects": [
          "forge",
          "Avela",
          "Knowledge"
        ],
        "selectedProject": "",
        "bottomItems": [
          "连接",
          "运行时",
          "设置"
        ],
        "collapsed": false
      }
    },
    {
      "id": "recovery",
      "component": "RecoverySurface",
      "props": {
        "runtimeState": "不可用",
        "recoveryState": "恢复能力可用",
        "headline": "Forge 运行时没有响应",
        "body": "你的工作与计划仍然持久保存。桌面客户端可以通过独立恢复能力修复或重启运行时，而不会成为运行时权威。",
        "actions": [
          "诊断",
          "重启运行时",
          "修复",
          "打开日志"
        ],
        "diagnosticSummary": "2 分钟前最后正常 · Controller Home 可读 · 发布包可用"
      },
      "interactionPatternId": "system-recovery",
      "interactions": [
        { "event": "press", "actions": [{ "type": "emit_design_action", "actionId": "repair-runtime" }] }
      ]
    },
    {
      "id": "connections",
      "component": "ConnectionList",
      "props": {
        "connections": [
          {
            "name": "ChatGPT MCP",
            "state": "已连接",
            "lastVerified": "1 分钟前"
          },
          {
            "name": "OpenAI 本地提供方",
            "state": "已配置",
            "lastVerified": "今天"
          },
          {
            "name": "GitHub",
            "state": "已连接",
            "lastVerified": "今天"
          },
          {
            "name": "电脑控制",
            "state": "需要权限",
            "lastVerified": "昨天"
          }
        ],
        "selectedConnection": "ChatGPT MCP",
        "showLastVerified": true,
        "showPermissions": true
      }
    },
    {
      "id": "history",
      "component": "HistoryTimeline",
      "props": {
        "entries": [
          "08:14 运行时正常",
          "08:19 连接中断",
          "08:20 恢复能力健康确认"
        ],
        "selectedEntry": "08:20 恢复能力健康确认",
        "filter": "系统",
        "showRevisionIds": false
      }
    }
  ],
  "initialStateId": "unavailable",
  "states": [
    { "id": "healthy", "name": "运行时正常", "meaning": "运行时与恢复能力均可达；恢复能力保持可用但处于辅助位置。", "primaryAction": "diagnose-runtime" },
    { "id": "unavailable", "name": "运行时不可用", "meaning": "主运行时不可达，但独立恢复能力仍可使用。", "primaryAction": "repair-runtime" },
    { "id": "repairing", "name": "正在恢复", "meaning": "恢复能力正在执行有界修复或重启操作。", "constraints": ["不要把修复活动表示为工作生命周期状态。"] },
    { "id": "recovery-degraded", "name": "恢复能力降级", "meaning": "恢复能力自身无法建立足够事实以安全修复。", "primaryAction": "open-diagnostics" }
  ],
  "viewport": { "kind": "desktop", "platform": "macos", "preset": "macbook-14", "width": 1440, "height": 960, "safeTop": 0, "safeBottom": 0 },
  "quality": { "requiredStateIds": ["healthy", "unavailable", "repairing", "recovery-degraded"], "minimumHitTarget": 36 }
}

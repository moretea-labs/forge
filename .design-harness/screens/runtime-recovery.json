{
  "schemaVersion": 1,
  "id": "runtime-recovery",
  "name": "运行时与恢复",
  "goal": "在单一主工作区中查看运行时与独立恢复事实；主运行时不可用时仍可诊断或显式重启，不把系统机械状态铺成仪表盘。",
  "primaryAction": "diagnose-runtime",
  "constraints": [
    "macOS 系统标题栏拥有窗口 chrome，WebView 不绘制 traffic lights 或伪标题栏",
    "轻量侧栏 + 单主工作区，不使用状态卡 Dashboard 或常驻右侧检查器",
    "运行时不可用时界面仍可通过独立恢复使用",
    "诊断和重启动作只调用独立恢复权威，客户端不创建生命周期状态机",
    "版本、进程、探针等机械事实通过按需详情展示"
  ],
  "nodes": [
    {
      "id": "sidebar",
      "component": "MacSidebar",
      "props": {
        "active": "运行时",
        "assistantLabel": "助手",
        "projects": ["forge", "Avela", "Knowledge"],
        "selectedProject": "",
        "runtimePlacement": "sidebar-footer",
        "collapsed": false
      }
    },
    {
      "id": "recovery",
      "component": "RuntimeRecoverySurface",
      "props": {
        "runtimeState": "不可用",
        "recoveryState": "恢复能力可用",
        "headline": "Forge 运行时没有响应",
        "body": "桌面客户端继续通过独立恢复读取权威状态，不接管运行时生命周期。",
        "actions": ["刷新", "诊断", "重启运行时"],
        "detailsDisclosure": ["进程 ID", "发布版本", "最近观察", "探针结果"]
      },
      "interactionPatternId": "system-recovery",
      "interactions": [
        {"event": "diagnose", "actions": [{"type": "emit_design_action", "actionId": "diagnose-runtime"}]},
        {"event": "restart", "actions": [{"type": "emit_design_action", "actionId": "restart-runtime"}]}
      ]
    },
    {
      "id": "history",
      "component": "RecoveryHistoryDisclosure",
      "props": {
        "entries": ["08:14 运行时正常", "08:19 连接中断", "08:20 恢复能力健康确认"],
        "source": "standalone Recovery canonical audit via list_recovery_history",
        "bounded": true,
        "sanitized": true,
        "clientPersisted": false,
        "collapsedByDefault": true,
        "showRevisionIds": false
      }
    }
  ],
  "initialStateId": "unavailable",
  "states": [
    {"id": "healthy", "name": "运行时正常", "meaning": "主运行时与独立恢复均可达。", "primaryAction": "diagnose-runtime"},
    {"id": "unavailable", "name": "运行时不可用", "meaning": "主运行时不可达，但独立恢复仍可读取事实并执行显式操作。", "primaryAction": "diagnose-runtime"},
    {"id": "recovery-degraded", "name": "恢复能力降级", "meaning": "恢复能力自身无法建立足够事实以安全操作。", "primaryAction": "open-diagnostics"}
  ],
  "viewport": {"kind": "desktop", "platform": "macos", "preset": "macbook-14", "width": 1440, "height": 960, "safeTop": 0, "safeBottom": 0},
  "quality": {"requiredStateIds": ["healthy", "unavailable", "recovery-degraded"], "minimumHitTarget": 36}
}

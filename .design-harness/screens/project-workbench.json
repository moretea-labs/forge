{
  "schemaVersion": 1,
  "id": "project-workbench",
  "name": "项目工作台",
  "goal": "以轻量侧栏选择项目和工作，主区只聚焦当前工作/会话；计划、证据、运行时细节按需展开。",
  "primaryAction": "continue-selected-work",
  "constraints": [
    "macOS 系统标题栏负责窗口 chrome，WebView 不绘制红黄绿按钮或伪标题栏",
    "默认布局只有轻量侧栏 + 单主工作区，不使用三栏 Dashboard",
    "工作选择放在侧栏，列表直接来自 rh_work(list) canonical current semantic Work；不得从 rh_status 的机械活动摘要反推 Work 列表",
    "工作是唯一执行/进度节点；计划只作为按需上下文，不显示计划百分比或计划步骤状态",
    "运行时与恢复是独立主页面，不常驻右侧检查器",
    "自动推进任务展示绑定会话与切换新会话动作，详细 ID 与机械状态按需展开"
  ],
  "nodes": [
    {
      "id": "sidebar",
      "component": "MacSidebar",
      "props": {
        "active": "项目",
        "assistantLabel": "助手",
        "projects": [
          "forge",
          "Avela",
          "Knowledge"
        ],
        "selectedProject": "forge",
        "workListPlacement": "sidebar",
        "projectSource": "repository_list + rh_status(list) repositoryState",
        "workSource": "rh_work(list) current semantic Work",
        "runtimePlacement": "sidebar-footer",
        "collapsed": false
      }
    },
    {
      "id": "work-header",
      "component": "WorkDetailHeader",
      "props": {
        "title": "交付 MCP 助手与项目",
        "workId": "work-mcp",
        "semanticState": "进行中",
        "relationLabel": "需求子工作 · 依赖桌面基础",
        "controller": "ChatGPT",
        "planTitle": "Forge V3 桌面客户端 · r8",
        "updatedLabel": "12 分钟前更新"
      }
    },
    {
      "id": "focus",
      "component": "CurrentFocusCard",
      "props": {
        "summary": "围绕权威需求、工作与计划投影构建项目工作台。",
        "activity": "正在设计原生客户端信息架构",
        "controller": "ChatGPT",
        "startedAt": "08:21",
        "nextLikelyAction": "设计验收后实现可移植桌面壳层"
      }
    },
    {
      "id": "plan",
      "component": "PlanContextPanel",
      "props": {
        "title": "Forge V3 桌面客户端",
        "revision": "r8",
        "decisions": [
          "MCP 优先",
          "助手与项目为一级入口",
          "工作是执行节点",
          "计划仅作为描述性上下文"
        ],
        "currentFocus": "MCP 助手与项目",
        "nextActions": [
          "桌面客户端基础",
          "运行时与恢复引导",
          "MCP 当前与历史投影"
        ],
        "historyCount": 8,
        "executionProjection": "绑定工作在语义上完成时视为执行完成",
        "collapsedByDefault": true
      }
    },
    {
      "id": "evidence",
      "component": "EvidencePanel",
      "props": {
        "changedFiles": [
          "desktop/shell",
          "protocol/work-projection",
          "platform/macos"
        ],
        "checks": [
          "架构检查",
          "桌面类型检查"
        ],
        "artifacts": [
          "信息架构规范",
          "设计预览"
        ],
        "receipts": [
          "计划 r8",
          "设计工作室验证"
        ],
        "sourceRevision": "设计候选",
        "compact": true,
        "collapsedByDefault": true
      }
    },
    {
      "id": "composer",
      "component": "AgentComposer",
      "props": {
        "placeholder": "让 ChatGPT 继续当前工作…",
        "scopeLabel": "work-mcp",
        "modeLabel": "MCP",
        "suggestions": [
          "继续实现",
          "查看证据",
          "打开历史"
        ],
        "attachments": [
          "Plan r8"
        ],
        "shortcut": "⌘↵",
        "floatingBottomComposer": true
      },
      "interactionPatternId": "controller-composer",
      "interactions": [
        {
          "event": "submit",
          "actions": [
            {
              "type": "emit_design_action",
              "actionId": "continue-work"
            }
          ]
        }
      ]
    }
  ],
  "initialStateId": "normal",
  "states": [
    {
      "id": "normal",
      "name": "就绪",
      "meaning": "权威项目/工作投影可读取，并且可以选择工作。",
      "primaryAction": "continue-selected-work"
    },
    {
      "id": "loading",
      "name": "正在加载投影",
      "meaning": "正在读取 Forge 权威投影；导航和范围保持稳定。",
      "constraints": [
        "不要把未知数据渲染为空工作或零进度。"
      ]
    },
    {
      "id": "empty",
      "name": "暂无工作",
      "meaning": "项目有效，但当前没有工作投影。",
      "primaryAction": "ask-assistant"
    },
    {
      "id": "degraded",
      "name": "部分投影",
      "meaning": "部分权威事实暂不可用，其余客户端功能仍可使用。",
      "primaryAction": "inspect-source"
    }
  ],
  "viewport": {
    "kind": "desktop",
    "platform": "macos",
    "preset": "macbook-14",
    "width": 1440,
    "height": 960,
    "safeTop": 0,
    "safeBottom": 0
  },
  "quality": {
    "requiredStateIds": [
      "normal",
      "loading",
      "empty",
      "degraded"
    ],
    "minimumHitTarget": 36
  }
}

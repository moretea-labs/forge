{
  "schemaVersion": 1,
  "id": "project-workbench",
  "name": "Project Workbench",
  "goal": "从 Project 一屏理解 Requirement 根、Independent Work、串并行 Work 图、当前 Work、其 Plan 与证据，并可直接继续工作。",
  "primaryAction": "continue-selected-work",
  "constraints": [
    "MCP-first；Assistant 与 Projects 是一级入口",
    "Work 是唯一执行/进度节点；不得显示 Plan 百分比或 PlanStep 状态",
    "Requirement 只作为存在时的 goal root",
    "Runtime 机械状态只进 inspector",
    "WorkGraph 只表达 decomposition/dependency；continuation/supersession 进入 History",
    "macOS day-mode 半透明 vibrancy，避免 Dashboard/KPI 风格"
  ],
  "nodes": [
    {
      "id": "titlebar",
      "component": "NativeTitlebar",
      "props": {
        "title": "Forge",
        "subtitle": "Projects / forge",
        "runtimeState": "Runtime healthy",
        "mode": "MCP",
        "searchPlaceholder": "Search work, plans, files…",
        "showTrafficLights": true
      }
    },
    {
      "id": "sidebar",
      "component": "PrimarySidebar",
      "props": {
        "active": "Projects",
        "assistantLabel": "Assistant",
        "projects": [
          "forge",
          "Avela",
          "Knowledge"
        ],
        "selectedProject": "forge",
        "bottomItems": [
          "Connections",
          "Runtime",
          "Settings"
        ],
        "collapsed": false
      }
    },
    {
      "id": "context",
      "component": "ProjectContextBar",
      "props": {
        "projectName": "forge",
        "repository": "moretea-labs/forge",
        "branch": "main",
        "worktree": "main worktree",
        "sourceRevision": "design candidate",
        "historyMode": "Current"
      }
    },
    {
      "id": "graph",
      "component": "WorkGraph",
      "props": {
        "requirementTitle": "Forge V3 Desktop Client",
        "requirementId": "REQ-forge-v3-desktop-client-20260930",
        "nodes": [
          {
            "id": "work-ia",
            "title": "Freeze MCP-first IA",
            "state": "completed",
            "depth": 0
          },
          {
            "id": "work-foundation",
            "title": "Desktop foundation",
            "state": "open",
            "depth": 1,
            "relation": "decomposed"
          },
          {
            "id": "work-bootstrap",
            "title": "Runtime + Recovery bootstrap",
            "state": "open",
            "depth": 1,
            "relation": "parallel"
          },
          {
            "id": "work-mcp",
            "title": "Assistant + Projects MCP",
            "state": "open",
            "depth": 1,
            "relation": "depends-on foundation"
          },
          {
            "id": "work-local",
            "title": "Local conversations",
            "state": "open",
            "depth": 1,
            "relation": "later"
          },
          {
            "id": "work-connections",
            "title": "Connections + macOS quality",
            "state": "open",
            "depth": 1,
            "relation": "later"
          }
        ],
        "selectedWorkId": "work-mcp",
        "showDependencies": true,
        "showHistory": false,
        "independentLabel": "Independent Work"
      },
      "interactionPatternId": "work-selection",
      "interactions": [
        { "event": "select", "actions": [{ "type": "emit_design_action", "actionId": "select-work" }] }
      ]
    },
    {
      "id": "work-header",
      "component": "WorkDetailHeader",
      "props": {
        "title": "Deliver MCP Assistant + Projects",
        "workId": "work-mcp",
        "semanticState": "Open",
        "relationLabel": "Requirement child · depends on Desktop foundation",
        "controller": "ChatGPT",
        "planTitle": "Forge V3 Desktop Client · r8",
        "updatedLabel": "Updated 12 min ago"
      }
    },
    {
      "id": "focus",
      "component": "CurrentFocusCard",
      "props": {
        "summary": "Build the Project Workbench around canonical Requirement / Work / Plan projections.",
        "activity": "Designing native client information architecture",

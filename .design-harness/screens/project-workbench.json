{
  "schemaVersion": 1,
  "id": "project-workbench",
  "name": "项目工作台",
  "goal": "从项目一屏理解需求根、独立工作、串并行工作图、当前工作、其计划与证据，并可直接继续工作。",
  "primaryAction": "continue-selected-work",
  "constraints": [
    "MCP 优先；助手与项目是一级入口",
    "工作是唯一执行/进度节点；不得显示计划百分比或计划步骤状态",
    "需求仅在存在时作为目标根",
    "运行时机械状态只进入检查器",
    "工作图只表达拆分与依赖；继续与替代关系进入历史",
    "macOS day-mode 半透明 vibrancy，避免 Dashboard/KPI 风格"
  ],
  "nodes": [

  "initialStateId": "normal",
  "states": [
    { "id": "normal", "name": "就绪", "meaning": "权威项目/工作投影可读取，并且可以选择工作。", "primaryAction": "continue-selected-work" },
    { "id": "loading", "name": "正在加载投影", "meaning": "正在读取 Forge 权威投影；导航和范围保持稳定。", "constraints": ["不要把未知数据渲染为空工作或零进度。"] },
    { "id": "empty", "name": "暂无工作", "meaning": "项目有效，但当前没有工作投影。", "primaryAction": "ask-assistant" },
    { "id": "degraded", "name": "部分投影", "meaning": "部分权威事实暂不可用，其余客户端功能仍可使用。", "primaryAction": "inspect-source" }
  ],
  "viewport": { "kind": "desktop", "platform": "macos", "preset": "macbook-14", "width": 1440, "height": 960, "safeTop": 0, "safeBottom": 0 },
  "quality": { "requiredStateIds": ["normal", "loading", "empty", "degraded"], "minimumHitTarget": 36 }
}

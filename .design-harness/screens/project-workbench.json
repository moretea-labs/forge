        "startedAt": "08:21",
        "nextLikelyAction": "Implement portable desktop shell after design approval"
      }
    },
    {
      "id": "plan",
      "component": "PlanContextPanel",
      "props": {
        "title": "Forge V3 Desktop Client",
        "revision": "r8",
        "decisions": [
          "MCP first",
          "Assistant + Projects top-level",
          "Work is execution node",
          "Plan is descriptive only"
        ],
        "currentFocus": "MCP Assistant + Projects",
        "nextActions": [
          "Desktop foundation",
          "Runtime/Recovery bootstrap",
          "MCP current/history projections"
        ],
        "historyCount": 8,
        "executionProjection": "Executed when the bound Work is semantically completed"
      }
    },
    {
      "id": "evidence",
      "component": "EvidencePanel",
      "props": {
        "changedFiles": [
          "desktop/shell",
          "protocol/work-projection",
          "platform/macos"
        ],
        "checks": [
          "architecture",
          "desktop typecheck"
        ],
        "artifacts": [
          "IA spec",
          "design preview"
        ],
        "receipts": [
          "Plan r8",
          "Design Studio validation"
        ],
        "sourceRevision": "design candidate",
        "compact": true
      }
    },
    {
      "id": "inspector",
      "component": "RuntimeInspector",
      "props": {
        "runtime": "Healthy · local",
        "recovery": "Ready",
        "controllerConnection": "ChatGPT MCP · Connected",
        "projectConnection": "forge · active",
        "worktree": "kernel-v2/architecture",
        "processes": "0 active",
        "detailsCollapsed": false
      }
    },
    {
      "id": "composer",
      "component": "AgentComposer",
      "props": {
        "placeholder": "Ask ChatGPT to continue this Work…",
        "scopeLabel": "work-mcp",
        "modeLabel": "MCP",
        "suggestions": [
          "Continue implementation",
          "Review evidence",
          "Open history"
        ],
        "attachments": [
          "Plan r8"
        ],
        "shortcut": "⌘↵"
      },
      "interactionPatternId": "controller-composer",
      "interactions": [
        { "event": "submit", "actions": [{ "type": "emit_design_action", "actionId": "continue-work" }] }
      ]
    }
  ],
  "initialStateId": "normal",
  "states": [
    { "id": "normal", "name": "Ready", "meaning": "Canonical Project/Work projection is readable and a Work may be selected.", "primaryAction": "continue-selected-work" },
    { "id": "loading", "name": "Loading projection", "meaning": "Forge canonical projection is being read; navigation and scope remain stable.", "constraints": ["Do not render unknown data as empty Work or zero progress."] },
    { "id": "empty", "name": "No Work yet", "meaning": "The Project is valid but has no current Work projection.", "primaryAction": "ask-assistant" },
    { "id": "degraded", "name": "Partial projection", "meaning": "Some canonical facts are unavailable while the rest of the client remains usable.", "primaryAction": "inspect-source" }
  ],
  "viewport": { "kind": "desktop", "platform": "macos", "preset": "macbook-14", "width": 1440, "height": 960, "safeTop": 0, "safeBottom": 0 },
  "quality": { "requiredStateIds": ["normal", "loading", "empty", "degraded"], "minimumHitTarget": 36 }
}

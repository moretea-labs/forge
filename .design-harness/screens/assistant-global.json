{
  "schemaVersion": 1,
  "id": "assistant-global",
  "name": "全局助手",
  "goal": "本地编码 Agent 会话、真实工具活动和单一输入框主导内容，项目/checkout/Work 仅作为上下文。",
  "primaryAction": "send-agent-message",
  "constraints": [
    "macOS 拥有原生标题栏，侧栏可收起；默认不显示常驻右侧检查器。",
    "不出现 Local/MCP 模式切换与退役 Supervisor 自动续跑功能。",
    "项目、checkout 切换不重写现有会话历史，明确模型请求作用域。",
    "工具进度必须来自真实 provider；未知不能伪装成完成。",
    "弹出菜单支持 Escape 关闭并返回焦点，Arrow/Home/End 快速选择。"
  ],
  "nodes": [
    {
      "id": "sidebar",
      "component": "PrimarySidebar",
      "props": {
        "active": "会话",
        "projects": [
          "forge",
          "Avela"
        ],
        "collapsed": false
      }
    },
    {
      "id": "thread-index",
      "component": "ConversationIndex",
      "props": {
        "threads": [
          "最近会话",
          "当前项目会话"
        ],
        "query": "",
        "projectGroups": true
      }
    },
    {
      "id": "transcript",
      "component": "ConversationTranscript",
      "props": {
        "thread": "所选本地 Agent 会话",
        "turns": [
          "用户消息",
          "助手回复与真实工具活动"
        ],
        "inFlight": false
      }
    },
    {
      "id": "composer",
      "component": "AgentComposer",
      "props": {
        "placeholder": "描述需要实现或检查的工作…",
        "scopeLabel": "项目 · checkout · Work",
        "shortcut": "⌘↵"
      }
    }
  ],
  "initialStateId": "ready",
  "states": [
    {
      "id": "ready",
      "name": "会话就绪",
      "meaning": "可查看当前会话与目标上下文，允许发送真实请求。",
      "primaryAction": "send-agent-message"
    },
    {
      "id": "empty",
      "name": "新会话",
      "meaning": "唯一输入框，明确当前目标项目。",
      "primaryAction": "send-agent-message"
    },
    {
      "id": "loading",
      "name": "读取中",
      "meaning": "不将未知/加载中伪装为空结果。"
    },
    {
      "id": "running",
      "name": "Agent 正在处理",
      "meaning": "真实运行状态与可用停止操作，不伪造工具进度。"
    }
  ],
  "viewport": {
    "kind": "desktop",
    "platform": "macos",
    "preset": "macbook-14",
    "width": 1440,
    "height": 960,
    "safeTop": 0,
    "safeBottom": 0
  },
  "quality": {
    "requiredStateIds": [
      "ready",
      "empty",
      "loading",
      "running"
    ],
    "minimumHitTarget": 36
  }
}

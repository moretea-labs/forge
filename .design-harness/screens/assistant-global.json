{
  "schemaVersion": 1,
  "id": "assistant-global",
  "name": "Assistant Global",
  "goal": "展示 Forge-instance 范围、与任何 Project 无关的 Work，不把它们伪装成仓库项目。",
  "primaryAction": "open-or-create-assistant-work",
  "constraints": [
    "Assistant 与 Projects 同级",
    "不得要求每个 Work 都有 Requirement 或 Plan",
    "Local conversation 不得隐式创建 Requirement/Plan/Work"
  ],
  "nodes": [
    {
      "id": "titlebar",
      "component": "NativeTitlebar",
      "props": {
        "title": "Assistant",
        "subtitle": "Forge instance",
        "runtimeState": "Runtime healthy",
        "mode": "MCP",
        "searchPlaceholder": "Search Assistant work…",
        "showTrafficLights": true
      }
    },
    {
      "id": "sidebar",
      "component": "PrimarySidebar",
      "props": {
        "active": "Assistant",
        "assistantLabel": "Assistant",
        "projects": [
          "forge",
          "Avela",
          "Knowledge"
        ],
        "selectedProject": "",
        "bottomItems": [
          "Connections",
          "Runtime",
          "Settings"
        ],
        "collapsed": false
      }
    },
    {
      "id": "work-list",
      "component": "AssistantWorkList",
      "props": {
        "current": [
          "Daily Forge release summary",
          "Cross-project promotion ledger",
          "Mac maintenance"
        ],
        "history": [
          "September automation cleanup",
          "Connection audit"
        ],
        "selectedWorkId": "assistant-release-summary",
        "emptyMessage": "Assistant Work can exist without a Project, Requirement or Plan."
      },
      "interactions": [
        { "event": "select", "actions": [{ "type": "emit_design_action", "actionId": "select-work" }] }
      ]
    },
    {
      "id": "work-header",
      "component": "WorkDetailHeader",
      "props": {
        "title": "Daily Forge release summary",
        "workId": "assistant-release-summary",
        "semanticState": "Open",
        "relationLabel": "Assistant-global Work",
        "controller": "ChatGPT",
        "planTitle": "No Plan",
        "updatedLabel": "Today 08:00"
      }
    },
    {
      "id": "focus",
      "component": "CurrentFocusCard",
      "props": {
        "summary": "Summarize new release and runtime facts across projects.",
        "activity": "Waiting for next scheduled occurrence",
        "controller": "ChatGPT",
        "startedAt": "08:00",
        "nextLikelyAction": "Wake at next schedule"
      }
    },
    {
      "id": "inspector",
      "component": "RuntimeInspector",
      "props": {
        "runtime": "Healthy",
        "recovery": "Ready",
        "controllerConnection": "ChatGPT MCP",
        "projectConnection": "None",
        "worktree": "None",
        "processes": "0 active",
        "detailsCollapsed": false
      }
    },
    {
      "id": "composer",
      "component": "AgentComposer",
      "props": {
        "placeholder": "Ask Assistant…",
        "scopeLabel": "Assistant",
        "modeLabel": "MCP",
        "suggestions": [
          "Create independent Work",
          "Show history",
          "Open schedule"
        ],
        "attachments": [],
        "shortcut": "⌘↵"
      },
      "interactionPatternId": "controller-composer",
      "interactions": [
        { "event": "submit", "actions": [{ "type": "emit_design_action", "actionId": "continue-work" }] }
      ]
    }
  ],
  "initialStateId": "ready",
  "states": [
    { "id": "ready", "name": "Assistant ready", "meaning": "Forge-instance Work can be selected or continued without repository scope.", "primaryAction": "open-or-create-assistant-work" },
    { "id": "empty", "name": "No Assistant Work", "meaning": "No Forge-instance Work exists; local conversation can still remain lifecycle-free.", "primaryAction": "start-local-conversation" },
    { "id": "loading", "name": "Loading Assistant Work", "meaning": "Assistant Work projection is loading while the global scope remains known." }
  ],
  "viewport": { "kind": "desktop", "platform": "macos", "preset": "macbook-14", "width": 1440, "height": 960, "safeTop": 0, "safeBottom": 0 },
  "quality": { "requiredStateIds": ["ready", "empty", "loading"], "minimumHitTarget": 36 }
}

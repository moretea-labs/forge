{
  "schemaVersion": 1,
  "id": "work-focus",
  "name": "工作专注视图",
  "goal": "提供类似 Codex 的 macOS 专注工作面：左侧只负责任务/项目导航，中央只处理当前工作和会话，次级信息按需展开。",
  "primaryAction": "send-controller-instruction",
  "constraints": [
    "macOS 系统标题栏拥有窗口 chrome；不在 WebView 重复绘制 traffic lights",
    "轻量侧栏 + 单主工作区，不使用常驻右侧检查器",
    "当前工作与绑定会话优先；关键 Forge 事实以紧凑文本投影，计划、证据、ID 通过 disclosure 按需查看",
    "关键事实只能来自 canonical Runtime/Supervisor/Requirement/Plan/Work/Repository 投影，客户端不得推断或复制 authority",
    "运行时机械事实不占用当前工作主视图",
    "自动推进任务显示 exact conversation link；切换新会话只能调用 canonical Supervisor migration"
  ],
  "nodes": [
    {
      "id": "sidebar",
      "component": "MacSidebar",
      "props": {
        "active": "项目",
        "assistantLabel": "助手",
        "projects": [
          "forge",
          "Avela",
          "Knowledge"
        ],
        "selectedProject": "forge",
        "selectedWork": "work-mcp",
        "workListPlacement": "sidebar",
        "runtimePlacement": "sidebar-footer",
        "collapsed": false
      }
    },
    {
      "id": "work-header",
      "component": "FocusedWorkHeader",
      "props": {
        "title": "交付 MCP 助手与项目",
        "workId": "work-mcp",
        "semanticState": "进行中",
        "relationLabel": "需求子工作",
        "controller": "ChatGPT",
        "planTitle": "Forge V3 桌面客户端 · r8",
        "updatedLabel": "实时"
      }
    },
    {
      "id": "forge-facts",
      "component": "ForgeFactStrip",
      "props": {
        "facts": [
          "Work semantic state + semantic revision",
          "Repository dirty/clean",
          "Git branch + source revision",
          "Work nextSafeAction when canonical Runtime provides it"
        ],
        "requirementDisclosure": "Requirement title/outcome/acceptance criteria from rh_work(requirement_get)",
        "planDisclosure": "Plan goal/revision/items and canonical revisionHistory from rh_work(plan_get, detail)",
        "workDisclosure": "Work parent/dependencies/update time and canonical revisionHistory from rh_work(get, detail)",
        "attentionProjection": "仅展示 targetScope.workId 精确匹配当前 Work 的 pending UserRequest；来源为 rh_inbox(list)",
        "clientInference": false
      }
    },
    {
      "id": "needs-user",
      "component": "InlineUserRequestProjection",
      "props": {
        "visibility": "only-when-exact-current-work-has-pending-request",
        "content": ["title", "summary"],
        "mutatesInbox": false,
        "noGlobalInboxDump": true
      }
    },
    {
      "id": "plan",
      "component": "PlanContextPanel",
      "props": {
        "title": "计划上下文",
        "revision": "r8",
        "decisions": [
          "不建立计划进度状态机",
          "不建立影子工作图",
          "可移植渲染层"
        ],
        "currentFocus": "MCP 项目工作台",
        "nextActions": [
          "当前/历史投影",
          "按需详情",
          "键盘交互优化"
        ],
        "historyCount": 8,
        "executionProjection": "描述性上下文",
        "collapsedByDefault": true
      }
    },
    {
      "id": "automatic-continuation",
      "component": "AutomaticContinuationRow",
      "props": {
        "taskId": "forge:repo-forge:work:work-mcp",
        "workId": "work-mcp",
        "objective": "继续所选工作，直到完成交付或出现明确的用户阻塞。",
        "status": "推进中",
        "detail": "自动推进监督器负责外层推进轮次。",
        "conversationId": "精确 ChatGPT 会话 ID",
        "conversationUrl": "权威 ChatGPT 会话 URL",
        "nextAction": "默认继续同一个精确会话，除非用户显式切换。",
        "switchActionState": "不存在未决 provider outcome 阻塞迁移时可用"
      },
      "interactionPatternId": "automatic-continuation-inspection",
      "interactions": [
        {
          "event": "open_conversation",
          "actions": [
            {
              "type": "emit_design_action",
              "actionId": "open-automatic-continuation-conversation"
            }
          ]
        },
        {
          "event": "switch_conversation",
          "actions": [
            {
              "type": "emit_design_action",
              "actionId": "switch-automatic-continuation-conversation"
            }
          ]
        }
      ]
    },
    {
      "id": "semantic-history",
      "component": "SemanticRevisionHistory",
      "props": {
        "sources": ["Work revisionHistory", "Plan revisionHistory"],
        "presentation": "collapsed disclosure with revision, authored state/status, recordedAt, objective/goal and bounded counts",
        "currentRevisionDuplicated": false,
        "clientComputedProgress": false
      }
    },
    {
      "id": "evidence",
      "component": "EvidencePanel",
      "props": {
        "changedFiles": [
          "packages/desktop-core/work.ts",
          "apps/desktop/src/ProjectWorkbench.tsx",
          "adapters/local-api/work-projection.ts"
        ],
        "checks": [
          "类型检查通过",
          "架构检查通过"
        ],
        "artifacts": [
          "diff +184 −27",
          "语义审查"
        ],
        "receipts": [
          "上下文闭合",
          "验证回执"
        ],
        "sourceRevision": "候选版本",
        "compact": true,
        "collapsedByDefault": true
      }
    },
    {
      "id": "composer",
      "component": "AgentComposer",
      "props": {
        "placeholder": "向控制器发送指令…",
        "scopeLabel": "当前工作",
        "modeLabel": "MCP",
        "suggestions": [
          "继续",
          "查看差异",
          "运行检查"
        ],
        "attachments": [
          "计划",
          "证据"
        ],
        "shortcut": "⌘↵",
        "floatingBottomComposer": true
      },
      "interactionPatternId": "controller-composer",
      "interactions": [
        {
          "event": "submit",
          "actions": [
            {
              "type": "emit_design_action",
              "actionId": "continue-work"
            }
          ]
        }
      ]
    }
  ],
  "initialStateId": "focused",
  "states": [
    {
      "id": "focused",
      "name": "专注中",
      "meaning": "所选权威工作已在低干扰工作界面中打开。",
      "primaryAction": "send-controller-instruction"
    },
    {
      "id": "submitting",
      "name": "正在提交指令",
      "meaning": "控制器指令已发送，客户端正在等待权威确认。",
      "constraints": [
        "不要根据传输活动推断工作进度。"
      ]
    },
    {
      "id": "degraded",
      "name": "证据降级",
      "meaning": "工作身份仍可读取，但部分证据或运行时事实暂不可用。",
      "primaryAction": "retry-evidence"
    }
  ],
  "viewport": {
    "kind": "desktop",
    "platform": "macos",
    "preset": "macbook-14",
    "width": 1440,
    "height": 960,
    "safeTop": 0,
    "safeBottom": 0
  },
  "quality": {
    "requiredStateIds": [
      "focused",
      "submitting",
      "degraded"
    ],
    "minimumHitTarget": 36
  }
}
